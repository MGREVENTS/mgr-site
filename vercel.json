{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "redirects": [
    { "source": "/dj-:slug(.*)", "destination": "/", "statusCode": 301 },
    { "source": "/nos-dj-mgr-events", "destination": "/", "statusCode": 301 },
    { "source": "/nos-dj-mgr-events/", "destination": "/", "statusCode": 301 },
    { "source": "/formation-de-dj-mgr-school", "destination": "/", "statusCode": 301 },
    { "source": "/formation-de-dj-mgr-school/", "destination": "/", "statusCode": 301 },
    { "source": "/real", "destination": "/", "statusCode": 301 },
    { "source": "/real/", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/mariage", "destination": "/mariage.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/:slug", "destination": "/article.html" },
    { "source": "/salon-du-mariage", "destination": "/salon-du-mariage/index.html" },
    { "source": "/ginger-booking", "destination": "/ginger-booking/index.html" },
    { "source": "/app", "destination": "https://planniflow-4jrm.vercel.app/" },
    { "source": "/app/:path*", "destination": "https://planniflow-4jrm.vercel.app/:path*" },
    { "source": "/planning", "destination": "https://planniflow-4jrm.vercel.app/planning" },
    { "source": "/mobile-planning", "destination": "https://planniflow-4jrm.vercel.app/mobile-planning" },
    { "source": "/login", "destination": "https://planniflow-4jrm.vercel.app/login" },
    { "source": "/employees", "destination": "https://planniflow-4jrm.vercel.app/employees" },
    { "source": "/presences", "destination": "https://planniflow-4jrm.vercel.app/presences" },
    { "source": "/postes", "destination": "https://planniflow-4jrm.vercel.app/postes" },
    { "source": "/facturation", "destination": "https://planniflow-4jrm.vercel.app/facturation" },
    { "source": "/rapport", "destination": "https://planniflow-4jrm.vercel.app/rapport" },
    { "source": "/rapport-dj", "destination": "https://planniflow-4jrm.vercel.app/rapport-dj" },
    { "source": "/notes", "destination": "https://planniflow-4jrm.vercel.app/notes" },
    { "source": "/export", "destination": "https://planniflow-4jrm.vercel.app/export" },
    { "source": "/chat", "destination": "https://planniflow-4jrm.vercel.app/chat" },
    { "source": "/chat-page", "destination": "https://planniflow-4jrm.vercel.app/chat-page" },
    { "source": "/partner", "destination": "https://planniflow-4jrm.vercel.app/partner" },
    { "source": "/partner/:path*", "destination": "https://planniflow-4jrm.vercel.app/partner/:path*" },
    { "source": "/onboarding", "destination": "https://planniflow-4jrm.vercel.app/onboarding" },
    { "source": "/onboarding/:path*", "destination": "https://planniflow-4jrm.vercel.app/onboarding/:path*" },
    { "source": "/admin", "destination": "https://planniflow-4jrm.vercel.app/admin" },
    { "source": "/admin/:path*", "destination": "https://planniflow-4jrm.vercel.app/admin/:path*" },
    { "source": "/wedding", "destination": "https://planniflow-4jrm.vercel.app/wedding" },
    { "source": "/wedding/:path*", "destination": "https://planniflow-4jrm.vercel.app/wedding/:path*" },
    { "source": "/crm", "destination": "https://planniflow-4jrm.vercel.app/crm" },
    { "source": "/crm/:path*", "destination": "https://planniflow-4jrm.vercel.app/crm/:path*" },
    { "source": "/marketing", "destination": "https://planniflow-4jrm.vercel.app/marketing" },
    { "source": "/marketing/:path*", "destination": "https://planniflow-4jrm.vercel.app/marketing/:path*" },
    { "source": "/nomames", "destination": "https://planniflow-4jrm.vercel.app/nomames" },
    { "source": "/nomames/:path*", "destination": "https://planniflow-4jrm.vercel.app/nomames/:path*" },
    { "source": "/booking", "destination": "https://planniflow-4jrm.vercel.app/booking" },
    { "source": "/booking/:path*", "destination": "https://planniflow-4jrm.vercel.app/booking/:path*" },
    { "source": "/_next/:path*", "destination": "https://planniflow-4jrm.vercel.app/_next/:path*" },
    { "source": "/api/:path*", "destination": "https://planniflow-4jrm.vercel.app/api/:path*" },
    { "source": "/sw.js", "destination": "https://planniflow-4jrm.vercel.app/sw.js" },
    { "source": "/manifest.json", "destination": "https://planniflow-4jrm.vercel.app/manifest.json" },
    { "source": "/icons/:path*", "destination": "https://planniflow-4jrm.vercel.app/icons/:path*" },
    { "source": "/version.json", "destination": "https://planniflow-4jrm.vercel.app/version.json" },
    { "source": "/logo-mgr.png", "destination": "https://planniflow-4jrm.vercel.app/logo-mgr.png" },
    { "source": "/recrutement", "destination": "https://planniflow-4jrm.vercel.app/recrutement" },
    { "source": "/recrutement/:path*", "destination": "https://planniflow-4jrm.vercel.app/recrutement/:path*" },
    { "source": "/api/recrutement/:path*", "destination": "https://planniflow-4jrm.vercel.app/api/recrutement/:path*" }
  ]
}
